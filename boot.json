{
  "name": "more useful foodstuff",
  "nickName": {
    "cn": "更有用的食物",
    "en": "Food Effects Expanded"
  },
  "version": "0.2.57",
  "styleFileList": [
    "food-effects.css"
  ],
  "tweeFileList": [
    "FoodEffects.twee"
  ],
  "scriptFileList": [
    "food-effects.js"
  ],
  "scriptFileList_inject_early": [],
  "scriptFileList_earlyload": [],
  "scriptFileList_preload": [],
  "additionFile": [
    "README.md"
  ],
  "additionBinaryFile": [],
  "additionDir": [],
  "addonPlugin": [
    {
      "modName": "TweeReplacer",
      "addonName": "TweeReplacerAddon",
      "params": [
        {
          "passage": "Characteristics",
          "findString": "<<characteristic-box _physiqueConfig>>",
          "replace": "<<run setup.FoodEffectsExpanded.applyDisplayBuff(_physiqueConfig, \"physique\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_willpowerConfig, \"willpower\")>>\n<<characteristic-box _physiqueConfig>>"
        },
        {
          "passage": "Characteristics",
          "findString": "<<characteristic-box _skulduggeryConfig>>",
          "replace": "<<run setup.FoodEffectsExpanded.applyDisplayBuff(_skulduggeryConfig, \"skulduggery\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_dancingConfig, \"danceskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_swimmingConfig, \"swimmingskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_athleticsConfig, \"athletics\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_tendingConfig, \"tending\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_housekeepingConfig, \"housekeeping\")>>\n<<characteristic-box _skulduggeryConfig>>"
        },
        {
          "passage": "Characteristics",
          "findString": "<<if $options.images is 1>>\n\t\t\t<div id=\"player-body\">",
          "replace": "<<run setup.FoodEffectsExpanded.applyDisplayBuff(_seductionConfig, \"seductionskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_oralConfig, \"oralskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_chestConfig, \"chestskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_handsConfig, \"handskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_buttocksConfig, \"bottomskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_analConfig, \"analskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_thighsConfig, \"thighskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_feetConfig, \"feetskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_penileConfig, \"penileskill\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_vaginalConfig, \"vaginalskill\")>>\n<<if $options.images is 1>>\n\t\t\t<div id=\"player-body\">"
        },
        {
          "passage": "Characteristics",
          "findString": "<<characteristic-box _scienceConfig>>",
          "replace": "<<run setup.FoodEffectsExpanded.applyDisplayBuff(_scienceConfig, \"science\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_mathsConfig, \"maths\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_englishConfig, \"english\")>>\n<<run setup.FoodEffectsExpanded.applyDisplayBuff(_historyConfig, \"history\")>>\n<<characteristic-box _scienceConfig>>"
        }
      ],
      "modVersion": "^1.0.0"
    }
  ],
  "dependenceInfo": [
    {
      "modName": "TweeReplacer",
      "version": ">=1.7.0"
    }
  ],
  "imgFileList": []
}
